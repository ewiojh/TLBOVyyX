local function updateSkeleton()
    if not skeletonEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local lineIdx = 0

    if hasDrawing and not skeletonCircle then
        skeletonCircle = Drawing.new("Circle")
        skeletonCircle.Thickness = 1.5
        skeletonCircle.Color = Color3.fromRGB(255, 255, 255)
        skeletonCircle.NumSides = 16
        skeletonCircle.Filled = false
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not checkIsTeammate(plr) then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            local function get2D(name)
                local part = char:FindFirstChild(name)
                if not part then return nil end
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then return Vector2.new(pos.X, pos.Y) end
                return nil
            end

            local head = get2D("Head")
            local torso = get2D("UpperTorso") or get2D("Torso")
            local rootPart = get2D("HumanoidRootPart") or get2D("LowerTorso") or torso
            
            local rArm = get2D("RightUpperArm") or get2D("Right Arm")
            local lArm = get2D("LeftUpperArm") or get2D("Left Arm")
            local rHand = get2D("RightHand") or rArm
            local lHand = get2D("LeftHand") or lArm
            
            local rLeg = get2D("RightUpperLeg") or get2D("Right Leg")
            local lLeg = get2D("LeftUpperLeg") or get2D("Left Leg")
            local rFoot = get2D("RightFoot") or rLeg
            local lFoot = get2D("LeftFoot") or lLeg

            local function draw(a, b)
                if a and b then
                    lineIdx = lineIdx + 1
                    drawBone(a, b, lineIdx)
                end
            end

            if torso and rootPart then draw(torso, rootPart) end
            if torso then
                if rArm then draw(torso, rHand) end
                if lArm then draw(torso, lHand) end
            end
            if rootPart then
                if rLeg then draw(rootPart, rFoot) end
                if lLeg then draw(rootPart, lFoot) end
            end

            if hasDrawing and head and torso then
                skeletonCircle.Position = head
                local headRadius = math.clamp((torso - head).Magnitude * 0.4, 5, 30)
                skeletonCircle.Radius = headRadius
                skeletonCircle.Visible = true
            end
        end
    end

    for i = lineIdx + 1, #skeletonLines do
        skeletonLines[i].Visible = false
    end
    if hasDrawing and skeletonCircle and lineIdx == 0 then
        skeletonCircle.Visible = false
    end
end

