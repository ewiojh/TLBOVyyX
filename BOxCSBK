local function addSlider(parent, text, min, max, default, callback)
    default = math.clamp(default, min, max)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(1, 0, 0, 50)
    sliderFrame.BackgroundTransparency = 1
    sliderFrame.ZIndex = 604
    sliderFrame.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.Text = text .. " : " .. tostring(default)
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(50, 50, 50)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 604
    label.Parent = sliderFrame

    local barBg = Instance.new("Frame")
    barBg.Position = UDim2.fromOffset(0, 28)
    barBg.Size = UDim2.new(1, 0, 0, 6)
    barBg.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    barBg.ZIndex = 604
    barBg.Parent = sliderFrame
    round(barBg, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
    fill.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    fill.ZIndex = 604
    fill.Parent = barBg
    round(fill, 3)

    local dragBtn = Instance.new("TextButton")
    dragBtn.AnchorPoint = Vector2.new(0.5, 0.5)
    dragBtn.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    dragBtn.Size = UDim2.fromOffset(16, 16)
    dragBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dragBtn.Text = ""
    dragBtn.ZIndex = 605
    dragBtn.Parent = barBg
    round(dragBtn, 8)

    local function apply(relativeX)
        relativeX = math.clamp(relativeX, 0, 1)
        fill.Size = UDim2.fromScale(relativeX, 1)
        dragBtn.Position = UDim2.new(relativeX, 0, 0.5, 0)
        local val = math.floor(min + (max - min) * relativeX)
        label.Text = text .. " : " .. tostring(val)
        callback(val)
    end

    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSliders[barBg] = { dragging = true, onDrag = apply }
            local absPos = barBg.AbsolutePosition
            local absSize = barBg.AbsoluteSize
            if absSize.X > 0 then
                apply(math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1))
            end
        end
    end)
end

