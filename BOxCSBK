    dragBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dragBtn.Text = ""
    dragBtn.ZIndex = 605
    dragBtn.Parent = barBg
    round(dragBtn, 8)

    local function apply(relativeX)
        relativeX = math.clamp(relativeX, 0, 1)
        fill.Size = UDim2.fromScale(relativeX, 1)
        dragBtn.Position = UDim2.new(relativeX, 0, 0.5, 0)
        local val = math.floor(min + (max - min) * relativeX)
        label.Text = text .. " : " .. tostring(val)
        callback(val)
    end

    dragBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            ActiveSliders[barBg] = { dragging = true, onDrag = apply }
            local absPos = barBg.AbsolutePosition
            local absSize = barBg.AbsoluteSize
            if absSize.X > 0 then
                apply(math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1))
            end
        end
    end)
end

