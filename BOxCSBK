local Connections = {}
local function track(conn)
    table.insert(Connections, conn)
    return conn
end
local function disconnectAll()
    for _, c in ipairs(Connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(Connections)
end

local function tw(obj, props, time, style, dir)
    return TweenService:Create(obj, TweenInfo.new(time or CONFIG.ANIM_NORMAL, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
end
local function waitT(w)
    local done = false
    local conn = w.Completed:Connect(function() done = true end)
    w:Play()
    while not done do RunService.Heartbeat:Wait() end
    conn:Disconnect()
end
local function round(inst, radius)
    local existing = inst:FindFirstChildOfClass("UICorner")
    if existing then existing.CornerRadius = UDim.new(0, radius or 12); return existing end
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, radius or 12); c.Parent = inst; return c
end
local function makeStroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = inst
    return s
end

local ActiveDrags = setmetatable({}, { __mode = "k" })
local function makeDraggable(frame, dragTarget)
    dragTarget = dragTarget or frame
    local dragState = { dragging = false, mousePos = nil, framePos = nil }
    dragState.onMove = function(input)
        if not dragState.dragging then return end
        local delta = input.Position - dragState.mousePos
        frame.Position = UDim2.new(dragState.framePos.X.Scale, dragState.framePos.X.Offset + delta.X, dragState.framePos.Y.Scale, dragState.framePos.Y.Offset + delta.Y)
    end
    ActiveDrags[dragTarget] = dragState
    track(dragTarget.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragState.dragging = true; dragState.mousePos = input.Position; dragState.framePos = frame.Position
        end
    end))
    track(dragTarget.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragState.dragging = false end
    end))
end
track(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    for _, state in pairs(ActiveDrags) do state.onMove(input) end
end))

local ActiveSliders = setmetatable({}, { __mode = "k" })
track(UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
    for barBg, info in pairs(ActiveSliders) do
        if not info.dragging then continue end
        if not barBg.Parent then ActiveSliders[barBg] = nil; continue end
        local absPos = barBg.AbsolutePosition; local absSize = barBg.AbsoluteSize
        if absSize.X <= 0 then continue end
        info.onDrag(math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1))
    end
end))
track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        for _, info in pairs(ActiveSliders) do info.dragging = false end
    end
end))

