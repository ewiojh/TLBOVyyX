        opt.MouseButton1Click:Connect(function()
            STATE.Tracer_Mode = i
            dropdownBtn.Text = "模式: " .. modeName
            optionsFrame.Visible = false 
            if STATE.Tracer_Enabled then
                for _, line in pairs(tracerLines) do 
                    line.Visible = false 
                end
            end
        end)
    end

    dropdownBtn.MouseButton1Click:Connect(function()
        optionsFrame.Position = UDim2.fromOffset(dropdownBtn.Position.X.Offset, dropdownBtn.Position.Y.Offset + 44)
        optionsFrame.Visible = not optionsFrame.Visible
    end)

    local function updateTracers()
        if not STATE.Tracer_Enabled then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        
        local startPos = Vector2.new(cam.ViewportSize.X / 2, 0)
        local activeLines = 0
        
        local function draw(targetModel, color)
            local head = targetModel:FindFirstChild("Head")
            if not head then return end
            local targetPos, onScreen = cam:WorldToViewportPoint(head.Position)
            if onScreen and targetPos.Z > 0 then
                activeLines = activeLines + 1
                local line = tracerLines[activeLines]
                if not line then
                    if DrawingLib then
                        line = DrawingLib.new("Line")
                        line.Transparency = 1
                    else
                        line = Instance.new("Frame")
                        line.AnchorPoint = Vector2.new(0.5, 0)
                        line.BorderSizePixel = 0
                        line.ZIndex = 801
                        line.Parent = drawGui 
                    end
                    tracerLines[activeLines] = line
                end
                local endPos = Vector2.new(targetPos.X, targetPos.Y)
                
                if DrawingLib then
                    line.From = startPos
                    line.To = endPos
                    line.Color = color
                    line.Visible = true
                    line.Thickness = 1.5
                else
                    local dist = (endPos - startPos).Magnitude
                    line.Position = UDim2.fromOffset(startPos.X, startPos.Y)
                    line.Size = UDim2.fromOffset(1.5, dist)
                    line.Rotation = math.deg(math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X)) - 90
                    line.BackgroundColor3 = color
                    line.BackgroundTransparency = 0.2
                    line.Visible = true
                end
            end
        end

        if STATE.Tracer_Mode == 2 or STATE.Tracer_Mode == 3 then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character then
                    local char = plr.Character
                    if char:FindFirstChild("Head") then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 and not UIElements.CheckIsTeammate(plr) then
                            draw(char, Color3.fromRGB(80, 255, 120))
                        end
                    end
                end
            end
        end

        if STATE.Tracer_Mode == 1 or STATE.Tracer_Mode == 3 then
            for _, model in ipairs(workspace:GetDescendants()) do
                if model:IsA("Model") and model:FindFirstChild("Head") then
                    if not Players:GetPlayerFromCharacter(model) then
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            draw(model, Color3.fromRGB(255, 60, 60))
                        end
                    end
                end
            end
        end

        for i = activeLines + 1, #tracerLines do
            if DrawingLib then tracerLines[i].Visible = false else tracerLines[i].Visible = false end
        end
    end

    UIElements.AddToggle(espPage, "开启射线", false, function(state)
        STATE.Tracer_Enabled = state
        dropdownBtn.Visible = state 
        optionsFrame.Visible = false 
        if state then
            if not STATE.Tracer_Conn then 
                STATE.Tracer_Conn = RunService.RenderStepped:Connect(updateTracers) 
            end
        else
            if STATE.Tracer_Conn then 
                STATE.Tracer_Conn:Disconnect() 
                STATE.Tracer_Conn = nil 
            end
            for _, line in pairs(tracerLines) do 
                if DrawingLib then line.Visible = false else line.Visible = false end
            end
        end
    end).LayoutOrder = 3
end

