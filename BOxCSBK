    -- 开火逻辑
    local function fireConnections(sig)
        if not sig then return false end
        if type(_G.firesignal) == "function" then
            if pcall(_G.firesignal, sig) then return true end
        end
        if type(_G.getconnections) == "function" then
            local ok, conns = pcall(_G.getconnections, sig)
            if ok and type(conns) == "table" and #conns > 0 then
                for _, c in ipairs(conns) do
                    pcall(function()
                        if type(c.Fire) == "function" then c:Fire()
                        elseif type(c.fire) == "function" then c:fire() end
                    end)
                end
                return true
            end
        end
        return false
    end

    local function tryFire()
        local myChar = player.Character
        if not myChar then return end
        local tool = myChar:FindFirstChildOfClass("Tool")

        if STATE.Fire_Mode == 1 then
            if tool and fireConnections(tool.Activated) then return end
            if tool then pcall(function() tool:Activate() end) end
        else
            pcall(function()
                local VIM = game:GetService("VirtualInputManager")
                local cam = workspace.CurrentCamera
                local cx = cam.ViewportSize.X / 2
                local cy = cam.ViewportSize.Y / 2
                VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                task.wait(0.02)
                VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
            end)
        end
    end

    -- 主渲染循环
    RunService:BindToRenderStep("AimbotLock", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not STATE.Aimbot_Enabled then return end
        
        local cam = workspace.CurrentCamera
        local myChar = player.Character
        if not cam or not myChar then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local closestTarget = nil
        local minDistance = aimbotFOV

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and not UIElements.CheckIsTeammate(plr) then
                local char = plr.Character
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                
                if head and hum and hum.Health > 0 then
                    local targetPos, onScreen = cam:WorldToViewportPoint(head.Position)
                    local maxDist = (STATE.Aimbot_Mode == 2) and 99999 or aimbotFOV
                    
                    if onScreen and targetPos.Z > 0 then
                        local screenPos = Vector2.new(targetPos.X, targetPos.Y)
                        local dist = (screenPos - screenCenter).Magnitude
                        
                        if dist < maxDist then
                            local isVisible = true
                            if STATE.Aimbot_WallCheck then
                                local partsObscuring = cam:GetPartsObscuringTarget({head.Position}, {myChar, char})
                                if #partsObscuring > 0 then isVisible = false end
                            end
                            if isVisible then
                                minDistance = dist
                                closestTarget = head
                            end
                        end
                    end
                end
            end
        end
        
        targetCache = closestTarget
        if not targetCache or not targetCache.Parent then return end

        local pos = targetCache.Position
        if STATE.Aimbot_Mode == 2 then
            local root = targetCache.Parent and targetCache.Parent:FindFirstChild("HumanoidRootPart")
            if root then pos = pos + root.AssemblyLinearVelocity * aimbotPrediction end
            pos = pos + Vector3.new((math.random()-0.5) * 0.08, (math.random()-0.5) * 0.08, (math.random()-0.5) * 0.08)
        end

        local goal = CFrame.new(cam.CFrame.Position, pos)
        if aimbotSmoothness <= 0 or STATE.Aimbot_Mode == 2 then
            cam.CFrame = goal 
        else
            cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(1 - math.exp(-aimbotSmoothness * dt * 60), 0, 1))
        end

        if STATE.Aimbot_AutoFire and (tick() - lastFire >= 0.05) then
            lastFire = tick()
            tryFire()
        end
    end)
end

