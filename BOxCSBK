local function fireConnections(sig)
    if not sig then return false end
    if type(_G.firesignal) == "function" then
        if pcall(_G.firesignal, sig) then return true end
    end
    if type(_G.getconnections) == "function" then
        local ok, conns = pcall(_G.getconnections, sig)
        if ok and type(conns) == "table" and #conns > 0 then
            for _, c in ipairs(conns) do
                pcall(function()
                    if type(c.Fire) == "function" then c:Fire()
                    elseif type(c.fire) == "function" then c:fire() end
                end)
            end
            return true
        end
    end
    return false
end

local function tryFire()
    local myChar = player.Character
    if not myChar then return end
    local tool = myChar:FindFirstChildOfClass("Tool")

    if fireMode == 1 then
        -- 【PC 底层信号模式】
        if tool and fireConnections(tool.Activated) then return end
        if tool then pcall(function() tool:Activate() end) end
    else
        -- 【手机 触屏模式】(不改变 MouseEnabled，摇杆不会消失)
        pcall(function()
            local VIM = game:GetService("VirtualInputManager")
            local cam = workspace.CurrentCamera
            local cx = cam.ViewportSize.X / 2
            local cy = cam.ViewportSize.Y / 2
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
            task.wait(0.02)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
        end)
    end
end

