            UI_Lib.Tween(btn, { BackgroundColor3 = Color3.fromRGB(100, 200, 255) }, 0.1):Play()
            task.wait(0.1)
            UI_Lib.Tween(btn, { BackgroundColor3 = Color3.fromRGB(255, 255, 255) }, 0.1):Play()
        end)
    end

    UIElements.AddToggle(mainPage, "开启快捷切枪栏", false, function(state)
        weaponBarFrame.Visible = state
    end).LayoutOrder = 8
end

return MobileControls----------------------------------------------------------------
-- 模块 8：ESP 页面组装与状态控制
----------------------------------------------------------------
local ESPFeatures = {}

function ESPFeatures.Build(espPage, gui)
    -- 1. 构建灵动岛 UI
    local espIsland, redDot, greenDot, npcLabel, playerLabel = UIElements.BuildESPIsland(gui)

    -- 2. 呼吸灯与计数逻辑
    local espThread = nil
    local blinkConn = nil

    UIElements.AddToggle(espPage, "开启灵动岛计数", false, function(state)
        STATE.ESP_Enabled = state
        if espThread then task.cancel(espThread); espThread = nil end
        if blinkConn then blinkConn:Disconnect(); blinkConn = nil end
        
        redDot.BackgroundTransparency = 0
        greenDot.BackgroundTransparency = 0
        espIsland.Visible = state
        if not state then return end

        -- 呼吸灯逻辑
        local t = 0
        blinkConn = RunService.Heartbeat:Connect(function(dt)
            t = t + dt
            local a = (math.sin(t * 4) + 1) * 0.5
            redDot.BackgroundTransparency = a * 0.85
            greenDot.BackgroundTransparency = (1 - a) * 0.85
        end)

        -- 计数更新逻辑（降频处理，防止卡顿）
        espThread = task.spawn(function()
            while espIsland.Visible do
                local npcs, plrs = 0, 0
                for _, m in ipairs(workspace:GetDescendants()) do
                    if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
                        local p = Players:GetPlayerFromCharacter(m)
                        if p then 
                            if not UIElements.CheckIsTeammate(p) then plrs = plrs + 1 end
                        else 
                            npcs = npcs + 1 
                        end
                    end
                end
                npcLabel.Text = "NPC: " .. npcs
                playerLabel.Text = "玩家: " .. plrs
                task.wait(0.5)
            end
        end)
    end).LayoutOrder = 1

    -- 3. 团队检测总开关
    UIElements.AddToggle(espPage, "开启团队检测", false, function(state)
        STATE.TeamCheck_Enabled = state
    end).LayoutOrder = 2

    -- 4. 构建射线模块
    UIElements.BuildTracers(espPage)

    -- 5. 构建骨骼模块
    VisualFeatures.BuildSkeleton(espPage)

    -- 6. 角色重生时的状态重置保护
    player.CharacterAdded:Connect(function()
        task.wait(1)
        -- 避免复活后摇杆失效
        local touchGui = playerGui:FindFirstChild("TouchGui")
        if touchGui then
            local controlFrame = touchGui:FindFirstChild("TouchControlFrame")
            if controlFrame and not STATE.CustomControl_Enabled then
                controlFrame.Visible = true
            end
        end
    end)
end

return ESPFeatures----------------------------------------------------------------
-- 模块 9：主控引擎 (将所有模块组装并运行)
----------------------------------------------------------------
local Core = {}

function Core.Start()
    -- 1. 播放开场动画 (由于是 2 万行级脚本，先播个动画掩盖加载卡顿)
    SafeCall(UI_Lib.PlayIntro)
    task.wait(0.1)

    -- 2. 构建主面板骨架，并获取四个页面的引用
    local gui, mainPage, visualPage, espPage, aimbotPage = SafeCall(MainUI.Build)
    if not gui then
        return
    end

    -- 3. 初始化组件库并绑定页面
    UIElements.Init(mainPage, visualPage, espPage, aimbotPage)

    -- 4. 构建各个功能模块
    SafeCall(function()
        -- 组装主要功能 (飞行、移速、重力等)
        MainFeatures.Build(mainPage)
        
        -- 组装移动端控制 (摇杆、切枪)
        MobileControls.Build(mainPage)
        
        -- 组装视觉设置 (夜视、隐身、脱衣等)
        VisualFeatures.BuildVisuals(visualPage)
        
        -- 组装自瞄模块 (暴力锁头、开火)
        Aimbot.Init(aimbotPage)
        
        -- 组装 ESP (射线、骨骼、灵动岛)
        ESPFeatures.Build(espPage, gui)
    end)

    -- 5. 开启全局安全监控，防止游戏更新导致某个报错卡死面板
    task.spawn(function()
        while gui and gui.Parent do
            SafeCall(function()
                -- 每隔几秒检查一次角色状态，防止移动端UI卡死
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health <= 0 then
                        -- 如果玩家死亡，强行恢复部分状态，防止脚本锁死
                        if hum.PlatformStand then hum.PlatformStand = false end
                        if STATE.Fly_Enabled then
                            -- 复活后自动重置飞行状态
                            STATE.Fly_Enabled = false
                        end
                    end
                end
            end)
            task.wait(3)
        end
    end)
end

return Core----------------------------------------------------------------
-- 模块 10：最终入口与安全加载 (End of File)
----------------------------------------------------------------
local function SafeStart()
    -- 防止多次注入导致 UI 重复创建
    local existingGui = playerGui:FindFirstChild("DevConsole_" .. tostring(STATE.UI_NAME))
    if existingGui then
        existingGui:Destroy()
    end

    -- 使用 pcall 确保即使加载途中发生意外，也不会导致整个游戏崩溃
    local success, err = pcall(function()
        Core.Start()
    end)

    if not success then
        -- 如果是在开发环境下，可以打印错误信息
        warn("[Safe Bypass] Load Failed: " .. tostring(err))
    end
end

-- 使用 task.spawn 异步启动，不会阻塞游戏加载
task.spawn(SafeStart)