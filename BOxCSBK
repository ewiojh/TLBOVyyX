RunService:BindToRenderStep("DeltaAimbotLock", Enum.RenderPriority.Camera.Value + 2, function(dt)
    if not aimbotEnabled then return end
    
    local cam = workspace.CurrentCamera
    local myChar = player.Character
    if not cam or not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local screenCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local closestTarget = nil
    local minDistance = aimbotFOV

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local char = plr.Character
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if head and hum and hum.Health > 0 and not checkIsTeammate(plr) then
                local targetPos, onScreen = cam:WorldToViewportPoint(head.Position)
                local maxDist = (aimbotMode == 2) and 99999 or aimbotFOV
                
                if onScreen and targetPos.Z > 0 then
                    local screenPos = Vector2.new(targetPos.X, targetPos.Y)
                    local dist = (screenPos - screenCenter).Magnitude
                    
                    if dist < maxDist then
                        local isVisible = true
                        if aimbotWallCheck then
                            local partsObscuring = cam:GetPartsObscuringTarget({head.Position}, {myChar, char})
                            if #partsObscuring > 0 then isVisible = false end
                        end
                        if isVisible then
                            minDistance = dist
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end
    
    targetCache = closestTarget
    if not targetCache or not targetCache.Parent then return end

    local pos = targetCache.Position
    if aimbotMode == 2 then
        local root = targetCache.Parent and targetCache.Parent:FindFirstChild("HumanoidRootPart")
        if root then pos = pos + root.AssemblyLinearVelocity * aimbotPrediction end
        pos = pos + Vector3.new((math.random()-0.5) * 0.08, (math.random()-0.5) * 0.08, (math.random()-0.5) * 0.08)
    end

    local goal = CFrame.new(cam.CFrame.Position, pos)
    if aimbotSmoothness <= 0 or aimbotMode == 2 then
        cam.CFrame = goal 
    else
        cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(1 - math.exp(-aimbotSmoothness * dt * 60), 0, 1))
    end

    if aimbotAutoFire and (tick() - lastFire >= 0.05) then
        lastFire = tick()
        tryFire()
    end
end)

