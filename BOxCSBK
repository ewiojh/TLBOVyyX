    local function ModernFling(target)
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        local tChar = target.Character
        if not tChar then return end
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar:FindFirstChildOfClass("Humanoid")
        if not tRoot or not tHum then return end

        if (tRoot.Position - root.Position).Magnitude > 150 then return end

        tHum:ChangeState(Enum.HumanoidStateType.Ragdoll)
        tHum.PlatformStand = true

        local bv = Instance.new("BodyAngularVelocity")
        bv.Parent = root
        bv.AngularVelocity = Vector3.new(9e7, 9e7, 9e7)
        bv.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)

        local bvLin = Instance.new("BodyVelocity")
        bvLin.Parent = root
        bvLin.Velocity = Vector3.new(9e8, 9e8, 9e8)
        bvLin.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

        local bvT = Instance.new("BodyPosition")
        bvT.Parent = tRoot
        bvT.Position = root.Position
        bvT.MaxForce = Vector3.new(math.huge, math.huge, math.huge)

        task.spawn(function()
            local startTime = tick()
            while tick() - startTime < 0.5 do
                if not root or not tRoot or not tRoot.Parent then break end
                root.AssemblyLinearVelocity = Vector3.new(9e8, 9e8, 9e8)
                root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
                tRoot.CFrame = root.CFrame
                task.wait()
            end
            bv:Destroy(); bvLin:Destroy(); bvT:Destroy()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
        end)
    end

