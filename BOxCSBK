    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
}

local R6_Bones = {
    {"Head", "Torso"}, {"Torso", "Right Arm"}, {"Right Arm", "Right Leg"},
    {"Torso", "Left Arm"}, {"Left Arm", "Left Leg"},
    {"Torso", "Right Leg"}, {"Torso", "Left Leg"},
}

local Fallback_Bones = {
    {"Head", "Torso"}, {"Head", "UpperTorso"}, {"Torso", "HumanoidRootPart"}, {"UpperTorso", "LowerTorso"}, {"LowerTorso", "HumanoidRootPart"},
    {"Torso", "Left Arm"}, {"Torso", "LeftUpperArm"}, {"Torso", "Right Arm"}, {"Torso", "RightUpperArm"},
    {"HumanoidRootPart", "Left Leg"}, {"HumanoidRootPart", "LeftUpperLeg"}, {"HumanoidRootPart", "Right Leg"}, {"HumanoidRootPart", "RightUpperLeg"},
}

local function getBoneTable()
    if skeletonMode == 1 then return R15_Bones end
    if skeletonMode == 2 then return R6_Bones end
    return Fallback_Bones
end

local function drawBoneLine(fromPos, toPos, index)
    local line = skeletonLines[index]
    if not line then
        if hasDrawing then
            line = Drawing.new("Line")
            line.Thickness = 1.5
            line.Transparency = 1
        else
            line = Instance.new("Frame")
            line.AnchorPoint = Vector2.new(0.5, 0)
            line.BorderSizePixel = 0
            line.ZIndex = 801
            line.Parent = drawGui
        end
        skeletonLines[index] = line
    end

    if hasDrawing then
        line.From = fromPos
        line.To = toPos
        line.Color = Color3.fromRGB(255, 255, 255)
        line.Visible = true
    else
        local dist = (toPos - fromPos).Magnitude
        line.Position = UDim2.fromOffset(fromPos.X, fromPos.Y)
        line.Size = UDim2.fromOffset(1.5, dist)
        line.Rotation = math.deg(math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)) - 90
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.Visible = true
    end
end

local function updateMultiSkeleton()
    if not skeletonEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local boneTable = getBoneTable()
    local lineIdx = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and not checkIsTeammate(plr) then
            local char = plr.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            local function get2D(partName)
                local part = char:FindFirstChild(partName)
                if not part then return nil end
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    return Vector2.new(pos.X, pos.Y)
                end
                return nil
            end

            for _, bone in ipairs(boneTable) do
                local p1 = get2D(bone[1])
                local p2 = get2D(bone[2])
                if p1 and p2 then
                    lineIdx = lineIdx + 1
                    drawBoneLine(p1, p2, lineIdx)
                end
            end
        end
    end

    for i = lineIdx + 1, #skeletonLines do
        if hasDrawing then skeletonLines[i].Visible = false else skeletonLines[i].Visible = false end
    end
end

