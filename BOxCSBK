    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.VerticalAlignment = Enum.VerticalAlignment.Center
    list.Padding = UDim.new(0, 10)
    list.Parent = line

    local function makeLetter(char, order)
        local lbl = Instance.new("TextLabel")
        lbl.LayoutOrder = order
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBlack
        lbl.Text = char
        lbl.TextSize = 150
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.TextTransparency = 1
        lbl.Size = UDim2.fromOffset(0, 180)
        lbl.AutomaticSize = Enum.AutomaticSize.X
        UI_Lib.AddGradient(lbl, CONFIG.BRAND_GRADIENT, 90)
        lbl.Parent = line
        return lbl
    end

    local vLabel = makeLetter("V", 1)
    local restLabels = {}
    local rest = "FXVOBOX"
    for i = 1, #rest do
        table.insert(restLabels, makeLetter(rest:sub(i, i), i + 1))
    end

    UI_Lib.Tween(shade, { BackgroundTransparency = 0.35 }, 0.8):Play()
    UI_Lib.Tween(introBlur, { Size = 18 }, 0.8):Play()
    task.wait(0.35)

    vLabel.TextSize = 84
    UI_Lib.Tween(vLabel, { TextTransparency = 0 }, 0.45):Play()
    UI_Lib.Tween(vLabel, { TextSize = 150 }, 0.5, Enum.EasingStyle.Back):Play()
    task.wait(0.5)

    local w1 = UI_Lib.Tween(line, { Position = UDim2.new(0.5, -24, 0.5, 0) }, 0.5)
    w1:Play()
    w1.Completed:Wait()

    for _, lbl in ipairs(restLabels) do
        lbl.TextSize = 108
        UI_Lib.Tween(lbl, { TextTransparency = 0 }, 0.28):Play()
        UI_Lib.Tween(lbl, { TextSize = 150 }, 0.42, Enum.EasingStyle.Back):Play()
        task.wait(0.09)
    end
    
    task.wait(0.35)
    
    local w2 = UI_Lib.Tween(line, { Position = UDim2.new(0.5, -10, 0.5, 0) }, 0.22)
    w2:Play()
    w2.Completed:Wait()
    
    local w3 = UI_Lib.Tween(line, { Position = UDim2.new(0.5, 0, 0.5, 0) }, CONFIG.ANIM_SLOW, Enum.EasingStyle.Back)
    w3:Play()
    w3.Completed:Wait()
    
    task.wait(1.2)

    UI_Lib.Tween(vLabel, { TextTransparency = 1 }, 0.6):Play()
    for _, lbl in ipairs(restLabels) do
        UI_Lib.Tween(lbl, { TextTransparency = 1 }, 0.6):Play()
    end
    UI_Lib.Tween(shade, { BackgroundTransparency = 1 }, 0.6):Play()
    UI_Lib.Tween(introBlur, { Size = 0 }, 0.6):Play()
    task.wait(0.7)

    introBlur:Destroy()
    introGui:Destroy()
