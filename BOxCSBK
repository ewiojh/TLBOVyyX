    ----------------------------------------------------------------
    -- 1. 飞行系统 (支持手机摇杆 + 速度调节)
    ----------------------------------------------------------------
    local flySpeed = 50 
    UIElements.AddToggle(mainPage, "开启飞行 (摇杆控制)", false, function(state)
        STATE.Fly_Enabled = state
        if STATE.Fly_Conn then STATE.Fly_Conn:Disconnect(); STATE.Fly_Conn = nil end
        
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        if state then
            hum.PlatformStand = true
            char.Animate.Disabled = true
            local targetPart = char:FindFirstChild("HumanoidRootPart")
            if not targetPart then return end

            local bg = Instance.new("BodyGyro", targetPart)
            bg.P = 9e4
            bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.cframe = targetPart.CFrame

            local bv = Instance.new("BodyVelocity", targetPart)
            bv.velocity = Vector3.new(0, 0.1, 0)
            bv.maxForce = Vector3.new(9e9, 9e9, 9e9)

            local speed = 0
            STATE.Fly_Conn = RunService.RenderStepped:Connect(function()
                if not STATE.Fly_Enabled or not char or not char.Parent or not hum then return end
                
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    speed = speed + .5 + (speed / flySpeed)
                    if speed > flySpeed then speed = flySpeed end
                    
                    bv.velocity = (workspace.CurrentCamera.CFrame.LookVector * (moveDir:Dot(workspace.CurrentCamera.CFrame.LookVector))) * speed 
                                  + (workspace.CurrentCamera.CFrame.RightVector * (moveDir:Dot(workspace.CurrentCamera.CFrame.RightVector))) * speed
                    bv.velocity = bv.velocity + Vector3.new(0, 0.1, 0)
                else
                    speed = speed - 1
                    if speed < 0 then speed = 0 end
                    bv.velocity = Vector3.new(0, 0.1, 0) 
                end
                bg.cframe = workspace.CurrentCamera.CFrame
            end)
        else
            hum.PlatformStand = false
            char.Animate.Disabled = false
            local targetPart = char:FindFirstChild("HumanoidRootPart")
            if targetPart then
                local bg = targetPart:FindFirstChildOfClass("BodyGyro")
                local bv = targetPart:FindFirstChildOfClass("BodyVelocity")
                if bg then bg:Destroy() end
                if bv then bv:Destroy() end
            end
        end
    end).LayoutOrder = 1

