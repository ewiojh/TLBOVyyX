local UI_Lib = {}

function UI_Lib.Tween(obj, props, time, style, dir)
    return TweenService:Create(
        obj,
        TweenInfo.new(time or CONFIG.ANIM_NORMAL, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
        props
    )
end

function UI_Lib.Round(inst, radius)
    local existing = inst:FindFirstChildOfClass("UICorner")
    if existing then
        existing.CornerRadius = UDim.new(0, radius or 12)
        return existing
    end
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 12)
    c.Parent = inst
    return c
end

function UI_Lib.Stroke(inst, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0
    s.Parent = inst
    return s
end

function UI_Lib.AddGradient(inst, colorSequence, rotation)
    local g = Instance.new("UIGradient")
    g.Color = colorSequence
    g.Rotation = rotation or 0
    g.Parent = inst
    return g
end

