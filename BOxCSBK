local VisualFeatures = {}

function VisualFeatures.BuildSkeleton(espPage)
    local skeletonLines = {}
    local skeletonConn = nil

    local function drawBone(fromPos, toPos, index)
        local line = skeletonLines[index]
        if not line then
            if DrawingLib then
                line = DrawingLib.new("Line")
                line.Thickness = 1.5
                line.Transparency = 1
            else
                line = Instance.new("Frame")
                line.AnchorPoint = Vector2.new(0.5, 0)
                line.BorderSizePixel = 0
                line.ZIndex = 801
                line.Parent = STATE.DrawGui
            end
            skeletonLines[index] = line
        end

        local color = Color3.fromRGB(255, 255, 255)

        if DrawingLib then
            line.From = fromPos
            line.To = toPos
            line.Color = color
            line.Visible = true
        else
            local dist = (toPos - fromPos).Magnitude
            line.Position = UDim2.fromOffset(fromPos.X, fromPos.Y)
            line.Size = UDim2.fromOffset(1.5, dist)
            line.Rotation = math.deg(math.atan2(toPos.Y - fromPos.Y, toPos.X - fromPos.X)) - 90
            line.BackgroundColor3 = color
            line.Visible = true
        end
    end

    local function updateSkeleton()
        if not STATE.Skeleton_Enabled then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local lineIdx = 0

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character and not UIElements.CheckIsTeammate(plr) then
                local char = plr.Character
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end

                local function get2D(name)
                    local part = char:FindFirstChild(name)
                    if not part then return nil end
                    local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and pos.Z > 0 then return Vector2.new(pos.X, pos.Y) end
                    return nil
                end

                local head = get2D("Head")
                local torso = get2D("UpperTorso") or get2D("Torso")
                local rootPart = get2D("HumanoidRootPart") or get2D("LowerTorso") or torso
                
                local rArm = get2D("RightUpperArm") or get2D("Right Arm")
                local lArm = get2D("LeftUpperArm") or get2D("Left Arm")
                local rHand = get2D("RightHand") or rArm
                local lHand = get2D("LeftHand") or lArm
                
                local rLeg = get2D("RightUpperLeg") or get2D("Right Leg")
                local lLeg = get2D("LeftUpperLeg") or get2D("Left Leg")
                local rFoot = get2D("RightFoot") or rLeg
                local lFoot = get2D("LeftFoot") or lLeg

                local function draw(a, b)
                    if a and b then
                        lineIdx = lineIdx + 1
                        drawBone(a, b, lineIdx)
                    end
                end

                -- 躯干竖线
                if torso and rootPart then draw(torso, rootPart) end
                
                -- 手臂连线
                if torso then
                    if rArm then draw(torso, rHand) end
                    if lArm then draw(torso, lHand) end
                end
                
                -- 腿部连线
                if rootPart then
                    if rLeg then draw(rootPart, rFoot) end
                    if lLeg then draw(rootPart, lFoot) end
                end

                -- 头部十字线
                if head and torso then
                    draw(torso, head)
                    local headWidth = math.clamp((torso - head).Magnitude * 0.6, 10, 40)
                    local leftPos = Vector2.new(head.X - headWidth, head.Y)
                    local rightPos = Vector2.new(head.X + headWidth, head.Y)
                    draw(leftPos, rightPos)
                    local upPos = Vector2.new(head.X, head.Y - headWidth)
                    draw(head, upPos)
                end
            end
        end

        for i = lineIdx + 1, #skeletonLines do
            if DrawingLib then skeletonLines[i].Visible = false else skeletonLines[i].Visible = false end
        end
    end

    UIElements.AddToggle(espPage, "2D 骨骼透视", false, function(state)
        STATE.Skeleton_Enabled = state
        if state then
            if not skeletonConn then skeletonConn = RunService.RenderStepped:Connect(updateSkeleton) end
        else
            if skeletonConn then skeletonConn:Disconnect(); skeletonConn = nil end
            for _, line in pairs(skeletonLines) do 
                if DrawingLib then line.Visible = false else line.Visible = false end
            end
        end
    end).LayoutOrder = 7
end

